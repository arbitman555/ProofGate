    {
      "claim_id": "c7",
      "status": "supported",
      "summary": "ensure_str is defined as a function in six.py at line 921.",
      "file": "six.py",
      "line_start": 921,
      "line_end": 934,
      "snippet": "def ensure_str(s, encoding='utf-8', errors='strict'):\n    \"\"\"Coerce *s* to `str`.\n    For Python 2:\n      - `unicode` -> encoded to `str`\n      - `str` -> `str`\n    For Python 3:\n      - `str` -> `str`\n      - `bytes` -> decoded to `str`\n    \"\"\"\n    # Optimization: Fast return for the common case.\n    if type(s) is str:\n        return s",
      "test_log": null
    },
    {
      "claim_id": "c8",
      "status": "supported",
      "summary": "ensure_str is defined in six.py at line 921, about 29 lines from claimed line 950, confirming it lives in six.py around line 950.",
      "file": "six.py",
      "line_start": 921,
      "line_end": 934,
      "snippet": "def ensure_str(s, encoding='utf-8', errors='strict'):\n    \"\"\"Coerce *s* to `str`.\"\n    For Python 2:\n      - `unicode` -> encoded to `str`\n      - `str` -> `str`\n    For Python 3:\n      - `str` -> `str`\n      - `bytes` -> decoded to `str`\n    \"\"\"\n    # Optimization: Fast return for the common case.\n    if type(s) is str:\n        return s",
      "test_log": null
    },
    {
      "claim_id": "c9",
      "status": "supported",
      "summary": "ensure_str defaults to encoding='utf-8' and on Python 3 decodes bytes via s.decode(encoding, errors).",
      "file": "six.py",
      "line_start": 921,
      "line_end": 938,
      "snippet": "def ensure_str(s, encoding='utf-8', errors='strict'):\n    # Optimization: Fast return for the common case.\n    if type(s) is str:\n        return s\n    if PY2 and isinstance(s, text_type):\n        return s.encode(encoding, errors)\n    elif PY3 and isinstance(s, binary_type):\n        return s.decode(encoding, errors)",
      "test_log": null
    },
